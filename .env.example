# Copia este archivo como .env.local y llena los valores. Nunca subas .env.local.

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://wknyyiejvafdcwkdpoqr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: crea cuentas, cuenta intentos y firma URLs de CV. Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (para los enlaces de confirmación que salen por correo)
APP_URL=http://localhost:3000

# Resend: correos de confirmación. Sin clave, en desarrollo el enlace sale en la consola.
RESEND_API_KEY=
CORREO_REMITENTE="Selección <no-responder@tu-dominio.com>"

# Para pruebas con Gmail/Hotmail. En producción déjalo vacío (exige correo corporativo).
PERMITIR_CORREOS_PERSONALES=true

GEMINI_API_KEY=
