# Copia este archivo como .env.local y llena los valores. Nunca subas .env.local.

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://wknyyiejvafdcwkdpoqr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: crea cuentas, cuenta intentos y firma URLs de CV. Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Para pruebas con Gmail/Hotmail. En producción déjalo vacío (exige correo corporativo).
PERMITIR_CORREOS_PERSONALES=true

GEMINI_API_KEY=
# Plan de la clave de Gemini. Déjalo en false mientras la clave sea del plan GRATUITO (Google puede
# usar lo enviado para mejorar sus productos): la app muestra el aviso de modo de pruebas y solo se
# usan datos ficticios. Ponlo en true solo si la clave es de un proyecto con facturación activa.
GEMINI_PLAN_PAGO=false
